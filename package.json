{
  "name": "amazon-ai-decision-system",
  "version": "2.0.0",
  "description": "Amazon AI 决策系统 V2 — 工作流优先版（Research Job + Rule Engine + Evidence + Approval Gate）",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "seed": "tsx src/seed/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --strict",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:unit": "node --import tsx --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "node --import tsx --test \"tests/integration/**/*.test.ts\"",
    "build": "tsc --noEmit && echo BUILD_OK",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "iconv-lite": "^0.7.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
