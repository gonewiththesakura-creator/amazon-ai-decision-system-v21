# ===== 服务 =====
PORT=3000

# 数据库文件路径（相对项目根目录；留空则使用 data/amazon-ai.db）
DB_PATH=data/amazon-ai.db

# ===== AI（可选）=====
# 未配置时系统自动使用确定性分析引擎（model=rule-based-v1），不调用外部 LLM
# 配置后使用 OpenAI 兼容 Chat Completions 接口（支持自定义 base URL）
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-xxxx
# AI_MODEL=gpt-4o-mini
# AI_ENABLED=false

# ===== 演示数据 =====
# 首次启动自动生成演示数据（4 SKU / 记忆棉市场 / TOP100 / 评论），全部标记 is_demo=true
SEED_DEMO_ON_START=true

# ===== V2.1 真实数据源凭据（不配置则 Provider 如实标注 Unauthorized，REAL 模式任务转 needs_data）=====
# --- SellerSprite API（第三方市场估算，估算值会标记 ESTIMATED）---
# SELLERSPRITE_API_KEY=xxx

# --- SellerSprite MCP Server（可选；配置后启用 MCP 通道）---
# 远程模式（推荐，2026-09 实测 sellersprite.com MCP 网关）：
# SELLERSPRITE_MCP_ENABLED=true
# SELLERSPRITE_MCP_URL=https://mcp.sellersprite.com/mcp?
# SELLERSPRITE_MCP_SECRET=<你的 MCP Secret>
# stdio 模式（本地 MCP Server 进程）：
# SELLERSPRITE_MCP_SERVER=node /path/to/mcp-server/index.js

# --- Amazon SP-API（自有真实数据，优先级最高）---
# AMAZON_SPAPI_CLIENT_ID=xxx
# AMAZON_SPAPI_CLIENT_SECRET=xxx
# AMAZON_SPAPI_REFRESH_TOKEN=xxx

# --- Amazon Ads API ---
# AMAZON_ADS_CLIENT_ID=xxx
# AMAZON_ADS_CLIENT_SECRET=xxx
# AMAZON_ADS_REFRESH_TOKEN=xxx
# AMAZON_ADS_PROFILE_ID=xxx

# --- 真实文件导入（无需凭据；把 SellerSprite ReverseASIN 导出 / Amazon 报表放到本地后通过
#     POST /api/import/sellersprite/reverse-asin 与 POST /api/import/amazon/report 导入）---
